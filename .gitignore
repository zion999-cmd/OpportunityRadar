# dependencies
node_modules/

# build output (currently none, but guard for the future)
dist/
build/
*.tsbuildinfo

# environment / secrets
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.idea/
.vscode/

# test / coverage artifacts
coverage/
.nyc_output/
*.log

# SQLite databases (created by `npm run db:init` / CLI smoke).
# The directory itself is tracked via .gitkeep; the DB files are not.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
